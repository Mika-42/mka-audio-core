{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core",
      "displayName": "C++26 core without native SDKs",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MKA_BUILD_TESTS": "ON",
        "MKA_BUILD_ALSA": "OFF",
        "MKA_BUILD_JACK": "OFF",
        "MKA_BUILD_PIPEWIRE": "OFF",
        "MKA_BUILD_PULSEAUDIO": "OFF",
        "BUILD_GMOCK": "OFF",
        "INSTALL_GTEST": "OFF",
        "MKA_SANITIZER": "none"
      }
    },
    {
      "name": "asan",
      "inherits": "core",
      "displayName": "Core ASan and UBSan",
      "cacheVariables": {
        "MKA_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "core",
      "displayName": "Core control tests under ThreadSanitizer",
      "cacheVariables": {
        "MKA_SANITIZER": "thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 2
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 2
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^nonrt$"
        },
        "exclude": {
          "label": "^rt$"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 2
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
