function(check name root expected)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DASIO_MODULE=${ASIO_MODULE}" "-DSDK_ROOT=${root}"
        -P "${CMAKE_CURRENT_LIST_DIR}/asio_sdk_child.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "success")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${name} failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "${name} did not reject the invalid SDK as expected: ${output}${error}")
    endif()
endfunction()
