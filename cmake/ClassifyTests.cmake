# Included by CTest after GoogleTest discovery, so labels apply to real cases.
get_cmake_property(mka_ctest_variables VARIABLES)
set(mka_discovered_tests)
foreach(variable IN LISTS mka_ctest_variables)
    if(variable MATCHES "^mka-.*-tests_TESTS$")
        list(APPEND mka_discovered_tests ${${variable}})
    endif()
endforeach()
foreach(name IN LISTS mka_discovered_tests)
    if(name MATCHES "^core\\.")
        set(labels unit core nonrt)
    elseif(name MATCHES "^wasapi\\.")
        set(labels unit wasapi nonrt)
    elseif(name MATCHES "^probe\\.")
        set(labels unit allocation rt)
    elseif(name MATCHES "^pipewire\\.buffer\\.")
        set(labels unit pipewire nonrt)
    elseif(name MATCHES "^alsa\\.(ALSABackendHwTest|ALSAManualTest)\\.")
        set(labels integration hardware alsa)
    elseif(name MATCHES "^alsa\\.ALSABackendTest\\.Test(GetEndPoints$|OpenInvalid|StartWithoutOpen|CloseWithoutOpen)")
        set(labels unit alsa nonrt)
    elseif(name MATCHES "^alsa\\.")
        set(labels integration virtual alsa)
    elseif(name MATCHES "^(pipewire|jack|pulseaudio)\\.")
        set(labels integration server virtual ${CMAKE_MATCH_1})
    else()
        message(FATAL_ERROR "Unclassified test: ${name}")
    endif()
    if(name MATCHES "\\.(TestPlaySineWave|TestRecordAndPlayback|TestDuplexLoopback)$")
        list(APPEND labels manual)
    endif()
    if(NOT name MATCHES "^core\\." AND name MATCHES "RtContract|NoHeap|NoLibc|NullCallback|probe\\.")
        list(APPEND labels rt)
    endif()
    if(name MATCHES "^core\\.BackendLifecycleStress\\.")
        list(APPEND labels stress)
        set_tests_properties("${name}" PROPERTIES TIMEOUT 60)
    else()
        set_tests_properties("${name}" PROPERTIES TIMEOUT 30)
    endif()
    set_tests_properties("${name}" PROPERTIES LABELS "${labels}")
endforeach()
