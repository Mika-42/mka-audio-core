# Candidate development packages only; publishing/tagging is not a build action.
set(CPACK_PACKAGE_NAME "mka-audio-core")
set(CPACK_PACKAGE_VENDOR "mka-audio-core contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Portable Float32 audio backend library and C++ modules")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "mka-audio-core")
set(CPACK_GENERATOR "TGZ;ZIP")
set(CPACK_PACKAGE_FILE_NAME "mka-audio-core-${PROJECT_VERSION}-candidate-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_SOURCE_GENERATOR "TGZ")
set(CPACK_SOURCE_IGNORE_FILES "/[.]git/;/[.]git$;/build/;/cmake-build[^/]*/;/[.]env[^/]*$;/[.]aws/;/[.]codex/;[.]wav$;[.]s32$;[.]log$;[.]profraw$")
if(MKA_INSTALLED_BACKENDS)
    string(REPLACE ";" "\",\"" mka_backend_names "${MKA_INSTALLED_BACKENDS}")
    set(MKA_RELEASE_BACKENDS_JSON "[\"${mka_backend_names}\"]")
else()
    set(MKA_RELEASE_BACKENDS_JSON "[]")
endif()
configure_file(cmake/release-metadata.json.in "${CMAKE_CURRENT_BINARY_DIR}/release-metadata.json" @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/release-metadata.json"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/mka-audio-core)
install(FILES README.md CHANGELOG.md DESTINATION ${CMAKE_INSTALL_DOCDIR})
install(DIRECTORY docs/ DESTINATION ${CMAKE_INSTALL_DOCDIR}/docs FILES_MATCHING PATTERN "*.md")
install(DIRECTORY doc/ DESTINATION ${CMAKE_INSTALL_DOCDIR}/doc FILES_MATCHING PATTERN "*.md")
install(DIRECTORY examples/ DESTINATION ${CMAKE_INSTALL_DOCDIR}/examples
    FILES_MATCHING PATTERN "*.md" PATTERN "*.hpp" PATTERN "*.cpp")
if(TARGET mka-dsp-example)
    install(TARGETS mka-dsp-example RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
endif()
if(PROJECT_IS_TOP_LEVEL)
    include(CPack)
endif()
