# SDK inputs stay private to explicitly selected Windows targets.
function(mka_validate_asio_sdk sdk_directory output_directory)
    if(NOT IS_DIRECTORY "${sdk_directory}")
        message(FATAL_ERROR "MKA_ASIO_SDK_DIR must point to the separately supplied ASIOSDK directory")
    endif()
    get_filename_component(root "${sdk_directory}" REALPATH)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/asio-sdk-2.3.4.json" manifest)
    string(JSON count LENGTH "${manifest}" files)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON relative MEMBER "${manifest}" files ${index})
        if(NOT EXISTS "${root}/${relative}")
            message(FATAL_ERROR "ASIO SDK 2.3.4 is incomplete: ${relative}")
        endif()
        string(JSON expected GET "${manifest}" files "${relative}")
        file(SHA256 "${root}/${relative}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "ASIO SDK 2.3.4 checksum mismatch: ${relative}; review the SDK version and license")
        endif()
    endforeach()
    set(${output_directory} "${root}" PARENT_SCOPE)
endfunction()
