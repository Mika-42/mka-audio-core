set(MKA_SANITIZER "none" CACHE STRING "Runtime instrumentation: none, address, address-undefined or thread")
set_property(CACHE MKA_SANITIZER PROPERTY STRINGS none address address-undefined thread)
if(NOT MKA_SANITIZER MATCHES "^(none|address|address-undefined|thread)$")
    message(FATAL_ERROR "Unsupported MKA_SANITIZER=${MKA_SANITIZER}")
endif()
if(NOT MKA_SANITIZER STREQUAL "none")
    if(MSVC)
        if(NOT MKA_SANITIZER STREQUAL "address")
            message(FATAL_ERROR "MSVC supports MKA_SANITIZER=address; UBSan and TSan need GCC/Clang")
        endif()
        # MSVC's runtime checks and incremental linker are incompatible with ASan.
        string(REPLACE "/RTC1" "" CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG}")
        add_compile_options(/fsanitize=address /Zi)
        add_link_options(/INCREMENTAL:NO)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        if(MKA_SANITIZER STREQUAL "thread")
            add_compile_options(-fsanitize=thread -fno-omit-frame-pointer)
            add_link_options(-fsanitize=thread)
        elseif(MKA_SANITIZER STREQUAL "address")
            add_compile_options(-fsanitize=address -fno-omit-frame-pointer)
            add_link_options(-fsanitize=address)
        else()
            add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined)
            add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=undefined)
        endif()
    else()
        message(FATAL_ERROR "MKA_SANITIZER requires MSVC, GCC or Clang")
    endif()
endif()
# Interposing allocators and instrumenting them are separate verification modes.
set(MKA_ALLOCATOR_TESTS ON)
set(_mka_flags "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_DEBUG} ${CMAKE_CXX_FLAGS_RELEASE} ${CMAKE_CXX_FLAGS_RELWITHDEBINFO} ${CMAKE_CXX_FLAGS_MINSIZEREL}")
if(NOT MKA_SANITIZER STREQUAL "none" OR _mka_flags MATCHES "[-/]fsanitize=")
    set(MKA_ALLOCATOR_TESTS OFF)
endif()

option(MKA_ENABLE_COVERAGE "Generate LLVM source coverage for core tests" OFF)
if(MKA_ENABLE_COVERAGE)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "MKA_ENABLE_COVERAGE requires Clang and matching LLVM tools")
    endif()
    if(NOT MKA_BUILD_TESTS)
        message(FATAL_ERROR "MKA_ENABLE_COVERAGE requires MKA_BUILD_TESTS=ON")
    endif()
    if(NOT MKA_SANITIZER STREQUAL "none" OR _mka_flags MATCHES "[-/]fsanitize=")
        message(FATAL_ERROR "Coverage and sanitizers must use separate builds")
    endif()
    add_compile_options(-fprofile-instr-generate -fcoverage-mapping)
    add_link_options(-fprofile-instr-generate)
    set(MKA_ALLOCATOR_TESTS OFF)
endif()
