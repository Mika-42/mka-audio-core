@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(mkaAudioCore_AVAILABLE_BACKENDS "@MKA_INSTALLED_BACKENDS@")
include("${CMAKE_CURRENT_LIST_DIR}/mkaAudioCoreTargets-core.cmake")
set(mkaAudioCore_core_FOUND TRUE)
foreach(component IN LISTS mkaAudioCore_FIND_COMPONENTS)
    if(component STREQUAL "core")
        continue()
    endif()
    if(NOT component IN_LIST mkaAudioCore_AVAILABLE_BACKENDS)
        set(mkaAudioCore_${component}_FOUND FALSE)
        set(mkaAudioCore_NOT_FOUND_MESSAGE "Backend component ${component} was not compiled in this package")
        continue()
    endif()
    if(NOT TARGET mka::${component})
        if(component STREQUAL "alsa")
            find_dependency(ALSA)
        elseif(component STREQUAL "pipewire" OR component STREQUAL "jack" OR component STREQUAL "pulseaudio")
            find_dependency(PkgConfig)
            if(component STREQUAL "pipewire")
                pkg_check_modules(PIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3)
            elseif(component STREQUAL "jack")
                pkg_check_modules(JACK REQUIRED IMPORTED_TARGET jack)
            else()
                pkg_check_modules(PULSEAUDIO REQUIRED IMPORTED_TARGET libpulse)
            endif()
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/mkaAudioCoreTargets-${component}.cmake")
    endif()
    set(mkaAudioCore_${component}_FOUND TRUE)
endforeach()
check_required_components(mkaAudioCore)
